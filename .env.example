VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile (chaves de teste — sempre passam em dev)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Web Push — chave pública VAPID (par com VAPID_PRIVATE_KEY na Edge Function send-push)
# Gerar: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
# Geocoding preciso do endereço do tutor (número da casa).
# Google Cloud → habilitar "Geocoding API" + faturamento → chave em Credenciais.
# Restrição HTTP referrer: use a porta real do Vite (ex.: http://localhost:5181/*).
# Sem chave válida, o pin fica impreciso (Photon/OSM).
VITE_GOOGLE_MAPS_API_KEY=
