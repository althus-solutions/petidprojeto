# Supabase (obrigatório)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Z-API — WhatsApp (https://developer.z-api.io)
Z_API_INSTANCE_ID=
Z_API_TOKEN=
Z_API_CLIENT_TOKEN=

# Resend — e-mail (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=PetID <notificacoes@seudominio.com>

# Web Push — secrets na Edge Function send-push (não no n8n)
# VAPID_PUBLIC_KEY=  → também VITE_VAPID_PUBLIC_KEY no frontend
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:notificacoes@seudominio.com

# Ollama (RF-06 — Edge Function analyze-pet; opcional se active_provider=ollama)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

